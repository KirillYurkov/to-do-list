---
import './_nav.scss';
import { pages } from "@/data/data";
---
<nav class="nav header__nav">
      <ul class="nav__list header__list">
        {
          pages.map((page) => (
            <li class="nav__item header__item">
              <a href={page.url} class="nav__link header__link">
                {page.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>